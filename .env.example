# AI providers (server only; never prefix secrets with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional model override. Leave blank to use config/ai-operations.json or the AI operations repository.
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=
OPENAI_TTS_MODEL=
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=
# Optional public HTTPS JSON config URL from a separate AI-operations-only repository. No secrets in this file.
AI_OPERATIONS_CONFIG_URL=
# Optional read-only GitHub fine-grained token for a private config repository; server-side only.
AI_OPERATIONS_CONFIG_TOKEN=
# gemini (default from config) or openai; set only to force provider order.
AI_SCRIPT_PROVIDER=
AI_PROVIDER_TIMEOUT_MS=35000

# Firebase Web Authentication (public client configuration; values may also be configured in lib/firebase/client.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wycut5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wycut5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wycut5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=725460027937
NEXT_PUBLIC_FIREBASE_APP_ID=1:725460027937:web:f61ecd8203bf84375c7160
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-L4G5PVMJTM

# Google OAuth: web client ID is safe to expose; server audience must match it
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Flutterwave v4: verify endpoint paths, payload shape and card encryption against your enabled merchant product before live use.
# Current defaults are POST {base}/charges and POST {base}/charges/{id}/validate; do not assume every v4 product uses these paths.
FLW_SECRET_KEY=
FLW_V4_API_BASE=https://f4bexperience.flutterwave.com
FLW_V4_CHARGES_PATH=/charges
FLW_V4_CARD_FIELD=card

# Google Drive browser OAuth uses the same NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID above.
# Firebase Admin service account JSON encoded as base64. Keep this server-only.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Flutterwave webhook verification. Configure the webhook secret/hash in your Flutterwave dashboard.
FLW_WEBHOOK_SECRET_HASH=
# HTTPS URL template for the transaction-verification endpoint from your enabled Flutterwave v4 docs.
# Must contain {id} or {tx_ref} as supported by that endpoint.
FLW_V4_VERIFY_URL_TEMPLATE=

# Capacitor APK: bundle the UI and call the deployed Next.js API over HTTPS.
NEXT_PUBLIC_API_BASE_URL=https://your-deployed-wycut-domain.example
CAPACITOR_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Base64-encoded google-services.json from Firebase project wycut5 (needed for Android Google auth).
GOOGLE_SERVICES_JSON_BASE64=
# Flutterwave v4 card encryption: supply the public key in PEM/SPKI format only if that is the exact
# encryption format required by the v4 direct-card API enabled for your merchant account.
NEXT_PUBLIC_FLW_CARD_RSA_PUBLIC_KEY=
# Optional provider-specific v4 auth-continuation path. Use the exact path in your enabled merchant docs.
FLW_V4_VALIDATE_PATH_TEMPLATE=/charges/{id}/validate
