# AI script generation: configure Gemini and/or OpenAI. Gemini is tried first by default.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional text-to-speech fallback; if OpenAI TTS is configured, Deepgram is used only on fallback.
DEEPGRAM_API_KEY=
# Optional non-secret model/prompt overrides (local config/config/ai-operations.json works without these).
GEMINI_MODEL=
OPENAI_SCRIPT_MODEL=
OPENAI_TTS_MODEL=
DEEPGRAM_TTS_MODEL=
AI_SCRIPT_PROVIDER=
AI_PROVIDER_TIMEOUT_MS=75000
# HMAC secret for one-free-trial claim hashes (required to enable trials)
TRIAL_PEPPER=
# Emergency global cap: maximum free generations across all users per UTC day
FREE_TRIAL_DAILY_CAP=60
# Comma-separated, server-only lifetime-free verified Google emails
LIFETIME_FREE_EMAILS=
AI_OPERATIONS_CONFIG_URL=
AI_OPERATIONS_CONFIG_TOKEN=

# Google OAuth Web client ID: used for Google Drive access and native Google identity verification.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Firebase Admin service account JSON encoded as base64; server-only, never prefix with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Flutterwave v4 one-time recap checkout. Use the same merchant FLW_ENCRYPTION_KEY and FLW_V4_BASE_URL in WyCut and WyBuild when they share the merchant account.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# Production: https://f4bexperience.flutterwave.com ; sandbox: https://developersandbox-api.flutterwave.com
FLW_V4_BASE_URL=https://f4bexperience.flutterwave.com
# Shared secret must match WyBuild WYCUT_WEBHOOK_SHARED_SECRET exactly.
WYBUILD_WEBHOOK_SHARED_SECRET=

# Required only for the bundled Capacitor APK. API base must be your deployed HTTPS origin, no /api suffix.
NEXT_PUBLIC_API_BASE_URL=
# Set on the deployed Next.js API server for the bundled APK origins.
CAPACITOR_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Optional for automated Android builds if android/app/google-services.json is not already present.
GOOGLE_SERVICES_JSON_BASE64=

# Video -> transcript (v29). Uses GEMINI_API_KEY; Flash-Lite is the cheapest Gemini audio model.
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash-lite
# Max 5-minute audio parts one account may transcribe per day (80 = ~6.7 hours).
# TRANSCRIBE_DAILY_CHUNK_CAP=80

# Set to 0 to stop falling back to OpenAI Whisper (about 5x the cost of Gemini Flash-Lite) when Gemini transcription fails.
TRANSCRIBE_ALLOW_WHISPER_FALLBACK=1
